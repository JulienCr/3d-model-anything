        "crop",
        "uv"
      ],
      "additionalProperties": false,
      "properties": {
        "crop": {
          "type": "string"
        },
        "uv": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "frame": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "profile",
        "width_cm"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "flat",
            "moulded"
          ]
        },
        "width_cm": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        }
      }
    }
  }
}
